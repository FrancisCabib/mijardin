APP_NAME="Florería Mi Jardín"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Herd: dominio del sitio vinculado a esta carpeta (ej. floreria-mi-jardin.test)
APP_URL=http://floreria-mi-jardin.test

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CL

# Registro público vía /register (Fortify). En producción suele ir en false
# si los usuarios los crea solo el administrador.
FORTIFY_REGISTRATION_ENABLED=true

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Orígenes permitidos para el API (SPA React en otro dominio). En producción:
# lista separada por comas, sin espacios. Mismo dominio que Laravel puede ir vacío o APP_URL.
CORS_ALLOWED_ORIGINS=*

# Producción (checklist): APP_DEBUG=false, APP_ENV=production, php artisan config:cache,
# php artisan route:cache, php artisan view:cache, SESSION_ENCRYPT=true, MAIL_* real.

CATALOG_HERO_PRE_HEADLINE="Floreria boutique para regalos con intencion"
CATALOG_HERO_HEADLINE="Arreglos florales que hablan por ti"
CATALOG_HERO_SUB_HEADLINE="Combinamos flores frescas, diseno moderno y presentacion impecable para que cada entrega sea memorable."
CATALOG_HERO_CTA_TEXT="Comprar flores"
CATALOG_HERO_CTA_URL="#contacto"

VITE_APP_NAME="${APP_NAME}"
